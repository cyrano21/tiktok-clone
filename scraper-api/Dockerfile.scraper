FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg curl && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY api_server.py ./
COPY comments.json ./
# Scripts de régénération du catalogue (vidéos + commentaires réels via Apify).
# enrich_catalog.py lit APIFY_TOKEN (env) et écrit le catalogue dans /app/data
# (volume persistant) pour survivre aux redémarrages.
COPY enrich_catalog.py ./
COPY apify_source.py ./
RUN mkdir -p /app/data /app/data/video_cache

VOLUME ["/app/data"]
EXPOSE 8502

CMD ["python", "api_server.py", "--port", "8502"]
