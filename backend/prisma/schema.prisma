generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  username        String    @unique
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String
  displayName     String?
  bio             String?   @db.VarChar(200)
  avatarUrl       String?
  coverUrl        String?
  website         String?

  followerCount   Int       @default(0)
  followingCount  Int       @default(0)
  videoCount      Int       @default(0)
  likeCount       BigInt    @default(0)

  isVerified      Boolean   @default(false)
  isPrivate       Boolean   @default(false)
  isBanned        Boolean   @default(false)
  suspendedUntil  DateTime?
  moderationStrikes Int      @default(0)
  role             String    @default("user")
  plan             String    @default("FREE") // FREE | PRO | BUSINESS

  language        String    @default("fr")
  contentPrefs    Json      @default("[]")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subscription    Subscription?
  publishJobs     PublishJob[]

  videos          Video[]
  sounds          Sound[]
  likes           Like[]
  comments        Comment[]
  commentLikes    CommentLike[]
  followers       Follow[]       @relation("following")
  following       Follow[]       @relation("follower")
  messages        Message[]
  views           VideoView[]
  shares          Share[]
  saves           Save[]
  notifications   Notification[]
  liveStreams     LiveStream[]
  liveGifts        LiveGift[]

  conversationsAsP1 Conversation[] @relation("conv_p1")
  conversationsAsP2 Conversation[] @relation("conv_p2")

  tiktokAccount     TikTokAccount?

  blocksInitiated   UserBlock[]        @relation("Blocker")
  blocksReceived    UserBlock[]        @relation("Blocked")
  reportsFiled      Report[]
  moderationActions ModerationAction[] @relation("Moderator")
  appeals            Appeal[]          @relation("AppealUser")
  appealsReviewed    Appeal[]          @relation("AppealReviewer")

  @@index([username])
  @@index([email])
  @@index([createdAt])
  @@index([isBanned, suspendedUntil])
}

/// Stores the OAuth tokens for a user's connected TikTok account.
/// Tokens are encrypted at rest by the repository before reaching these text columns.
model TikTokAccount {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  openId                String   @unique
  scope                 String
  accessToken           String   @db.Text
  refreshToken          String   @db.Text
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime

  displayName          String?
  avatarUrl            String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([openId])
}

model Video {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  title           String?   @db.VarChar(150)
  description     String?   @db.Text

  // Legacy URLs remain for migration compatibility. New clients consume media
  // through /v1/media/* so private storage never relies on a public bucket URL.
  videoUrl        String
  thumbnailUrl    String?
  coverUrl        String?
  videoStorageKey String?
  thumbnailStorageKey String?
  duration        Float     @default(0)
  width           Int       @default(1080)
  height          Int       @default(1920)

  visibility      String    @default("public")
  allowDuet       Boolean   @default(true)
  allowStitch     Boolean   @default(true)
  allowComment    Boolean   @default(true)

  // Provenance is explicit so external research content can never be confused
  // with a native ORKY upload.
  sourceType      String    @default("ORKY_NATIVE")
  externalPlatform String?
  externalContentId String?
  externalUrl     String?   @db.Text
  externalCreatorUsername String?
  externalCreatorDisplayName String?
  externalCreatorAvatarUrl String? @db.Text

  viewCount       BigInt    @default(0)
  likeCount       BigInt    @default(0)
  commentCount    BigInt    @default(0)
  shareCount      BigInt    @default(0)
  saveCount       BigInt    @default(0)

  engagementScore Float     @default(0)
  isTrending      Boolean   @default(false)
  trendingRank    Int?

  locationLat     Float?
  locationLng     Float?
  locationName    String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  likes           Like[]
  comments        Comment[]
  shares          Share[]
  saves           Save[]
  views           VideoView[]
  hashtags        VideoHashtag[]
  productMatches  VideoProductMatch[]
  soundId         String?
  sound           Sound?    @relation(fields: [soundId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([isTrending, trendingRank])
  @@index([engagementScore])
  @@index([sourceType])
  @@unique([externalPlatform, externalContentId])
}

/// Links an ORKY video to one or more real Orchidy catalog entries. ORKY stores
/// only catalog identity; price, stock, currency and checkout authority stay in Orchidy.
model VideoProductMatch {
  id                   String   @id @default(uuid())
  videoId              String
  video                Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  orchidyCatalogItemId String
  variantKey           String   @default("")
  confidence           Float    @default(1)
  source               String   @default("manual") // manual | matcher | import
  status               String   @default("active") // active | rejected | archived
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([videoId, orchidyCatalogItemId, variantKey])
  @@index([videoId, status])
  @@index([orchidyCatalogItemId])
}

model Hashtag {
  id          String         @id @default(uuid())
  name        String         @unique
  videoCount  BigInt         @default(0)
  viewCount   BigInt         @default(0)
  isTrending  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  videos      VideoHashtag[]
}

model VideoHashtag {
  videoId   String
  hashtagId String
  video     Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([videoId, hashtagId])
}

model Sound {
  id          String   @id @default(uuid())
  title       String
  artist      String?
  audioUrl    String
  coverUrl    String?
  duration    Float    @default(0)
  videoCount  BigInt   @default(0)
  isOriginal  Boolean  @default(false)
  creatorId   String?
  creator     User?    @relation(fields: [creatorId], references: [id])
  createdAt   DateTime @default(now())

  videos      Video[]

  @@index([videoCount])
  @@index([createdAt])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId])
}

model Comment {
  id        String    @id @default(uuid())
  userId    String
  videoId   String
  parentId  String?
  text      String    @db.Text
  likeCount Int       @default(0)
  isPinned  Boolean   @default(false)
  isRemoved Boolean   @default(false)
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  likes     CommentLike[]

  @@index([videoId, createdAt])
  @@index([isRemoved])
}

model CommentLike {
  id        String   @id @default(uuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

model Follow {
  id           String   @id @default(uuid())
  followerId   String
  followingId  String
  createdAt    DateTime @default(now())

  follower     User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following    User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Share {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  platform  String   @default("in_app")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model Save {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model VideoView {
  id              String   @id @default(uuid())
  userId          String?
  videoId         String
  watchDuration   Float    @default(0)
  watchPercentage Float    @default(0)
  fromSource      String?
  createdAt       DateTime @default(now())

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
}

model Conversation {
  id             String    @id @default(uuid())
  participant1Id String
  participant2Id String
  lastMessageAt  DateTime?
  createdAt      DateTime  @default(now())

  participant1   User      @relation("conv_p1", fields: [participant1Id], references: [id])
  participant2   User      @relation("conv_p2", fields: [participant2Id], references: [id])
  messages       Message[]

  @@unique([participant1Id, participant2Id])
}

model Message {
  id              String       @id @default(uuid())
  conversationId  String
  senderId        String
  type            String       @default("text")
  content         String?      @db.Text
  mediaUrl        String?
  isRead          Boolean      @default(false)
  createdAt       DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model LiveStream {
  id           String    @id @default(uuid())
  userId       String
  title        String
  status       String    @default("live")
  streamKey    String    @unique
  viewerCount  Int       @default(0)
  likeCount    Int       @default(0)
  thumbnailUrl String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  user         User       @relation(fields: [userId], references: [id])
  gifts        LiveGift[]

  @@index([status])
  @@index([viewerCount])
}

model LiveGift {
  id            String     @id @default(uuid())
  streamId      String
  senderId      String
  giftType      String
  diamondValue  Int
  createdAt     DateTime   @default(now())

  stream        LiveStream @relation(fields: [streamId], references: [id])
  sender        User       @relation(fields: [senderId], references: [id])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String
  title       String
  body        String
  data        Json?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

/// SaaS subscription: FREE (free), PRO (9.99€/mo), BUSINESS (29.99€/mo).
/// Paid entitlements are synchronized from signed Stripe subscription webhooks.
model Subscription {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan       String // FREE | PRO | BUSINESS
  status     String   @default("active") // active | trialing | past_due | canceled
  priceCents Int      @default(0)
  startedAt  DateTime @default(now())
  renewsAt   DateTime?
  canceledAt DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Admin-managed visual branding. Customer-owned multi-tenant workspaces are not
/// advertised until ownership and membership models exist.
model Branding {
  id           String   @id @default(uuid())
  tenant       String   @unique @default("default")
  name         String   @default("ORKY")
  logoUrl      String?  @db.Text @default("/logo_orky.png")
  primaryColor String   @default("#7C3AED")
  accentColor  String   @default("#F72585")
  tagline      String?  @default("La vidéo qui vous ressemble")
  supportEmail String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Cross-posting queue. Jobs are not presented as delivered until an external
/// worker marks them published; unsupported platforms remain unavailable.
model PublishJob {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  videoId     String?
  videoUrl    String?
  caption     String?
  platform    String // tiktok | reels | shorts
  status      String    @default("scheduled") // scheduled | processing | published | failed | canceled
  scheduledAt DateTime?
  publishedAt DateTime?
  error       String?
  externalId  String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
  @@index([scheduledAt])
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id           String   @id @default(uuid())
  reporterId   String
  targetType   String
  targetId     String
  category     String
  reason       String?  @db.Text
  status       String   @default("pending")
  priority     Int      @default(0)
  resolution   String?
  actionNote   String?  @db.Text
  assignedToId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  resolvedAt   DateTime?

  reporter    User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, priority, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId, createdAt])
}

model ModerationAction {
  id          String   @id @default(uuid())
  moderatorId String
  targetType  String
  targetId    String
  action      String
  reason      String?  @db.Text
  expiresAt   DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())

  moderator   User     @relation("Moderator", fields: [moderatorId], references: [id], onDelete: Restrict)
  appeals     Appeal[]

  @@index([targetType, targetId, createdAt])
  @@index([moderatorId, createdAt])
}

model Appeal {
  id                 String   @id @default(uuid())
  userId             String
  moderationActionId String
  reason             String   @db.Text
  status             String   @default("pending")
  reviewerId         String?
  decisionNote       String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  resolvedAt         DateTime?

  user               User             @relation("AppealUser", fields: [userId], references: [id], onDelete: Cascade)
  moderationAction   ModerationAction @relation(fields: [moderationActionId], references: [id], onDelete: Cascade)
  reviewer           User?            @relation("AppealReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([userId, moderationActionId])
  @@index([status, createdAt])
}
