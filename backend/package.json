{
  "name": "orky-api",
  "version": "1.0.0",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "jest",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "fastify": "^4.26.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.1.0",
    "@fastify/websocket": "^10.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "prisma": "^5.9.0",
    "@prisma/client": "^5.9.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "redis": "^4.6.12",
    "@aws-sdk/client-s3": "^3.504.0",
    "@aws-sdk/s3-request-presigner": "^3.504.0",
    "sharp": "^0.33.2",
    "fluent-ffmpeg": "^2.1.2",
    "zod": "^3.22.4",
    "bullmq": "^5.1.9",
    "socket.io": "^4.7.4",
    "winston": "^3.11.0",
    "node-cron": "^3.0.3",
    "dotenv": "^16.4.1",
    "uuid": "^9.0.0",
    "stripe": "^17.7.0",
    "livekit-server-sdk": "^2.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/uuid": "^9.0.7",
    "@types/jest": "^29.5.14",
    "typescript": "^5.3.3",
    "ts-node-dev": "^2.0.0",
    "ts-jest": "^29.2.5",
    "jest": "^29.7.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "moduleFileExtensions": ["ts", "js", "json"],
    "clearMocks": true
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@5.22.0": true,
    "sharp@0.33.5": true
  }
}
