NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://tiktok:tiktok_secret@localhost:5432/tiktok_clone
REDIS_URL=redis://localhost:6379
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# Comma-separated browser origins. Mandatory in production when frontend/backend are cross-origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=tiktok-clone-videos
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Public URL prefix used in media URLs. For MinIO this usually includes the bucket name.
CDN_URL=http://localhost:9000/tiktok-clone-videos

# --- Stripe Billing ---
# Secret values belong only in backend/Coolify environment variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Live recurring prices created for this app. Override if you duplicate the Stripe account/catalogue.
STRIPE_PRICE_PRO=price_1U1mDNAh4XCbPrbnMiEUNHFJ
STRIPE_PRICE_BUSINESS=price_1U1mDXAh4XCbPrbnJbQxIXPt
# Public application URLs used by Checkout and Billing Portal redirects.
APP_URL=http://localhost:3000
STRIPE_SUCCESS_URL=http://localhost:3000/studio/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/studio/billing?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/studio/billing

# --- TikTok integration ---
# Obtain these from your app at https://developers.tiktok.com/
# The client secret is backend-only and must NEVER be exposed to the frontend.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must match exactly a redirect URI registered in your TikTok app (HTTPS in prod).
TIKTOK_REDIRECT_URI=http://localhost:3000/v1/tiktok/callback
# Where the backend sends the browser after a successful/failed connect.
TIKTOK_FRONTEND_RETURN_URL=http://127.0.0.1:5173/
# Scopes requested at consent time (comma-separated). Must match approved app.
# Login Kit only: user.info.basic,video.list
# With Content Posting API: user.info.basic,video.list,video.publish,video.upload
TIKTOK_SCOPES=user.info.basic,video.list
