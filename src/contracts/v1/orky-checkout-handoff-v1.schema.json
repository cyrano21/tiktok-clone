{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.orchids.local/v1/orky-checkout-handoff.schema.json",
  "title": "OrkyCheckoutHandoffV1",
  "description": "Handoff de panier émis par ORKY vers Orchidy (POST /api/orchidy/checkout-handoff côté ORKY, HMAC signé). Taille max 64 Ko. Aligné sur app/api/orchidy/checkout-handoff/route.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productId", "quantity"],
        "properties": {
          "productId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "variantKey": { "type": "string", "maxLength": 256 },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 999 },
          "selectedOptions": {
            "type": "object",
            "additionalProperties": { "type": "string", "maxLength": 512 },
            "maxProperties": 20
          }
        }
      }
    },
    "returnUrl": { "type": "string", "maxLength": 2048 }
  }
}