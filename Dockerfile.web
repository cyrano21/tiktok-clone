# ── Dependencies ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci --legacy-peer-deps

# ── Build ────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
# Required at build time for Next.js to inline NEXT_PUBLIC_* vars
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_SCRAPER_URL
ARG NEXT_PUBLIC_SCRAPER_API_URL
ARG NEXT_PUBLIC_ORCHIDY_BASE_URL
ARG NEXT_PUBLIC_USE_DEMO
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL:-}
ENV NEXT_PUBLIC_SCRAPER_URL=${NEXT_PUBLIC_SCRAPER_URL:-}
ENV NEXT_PUBLIC_SCRAPER_API_URL=${NEXT_PUBLIC_SCRAPER_API_URL:-/api/scraper}
ENV NEXT_PUBLIC_ORCHIDY_BASE_URL=${NEXT_PUBLIC_ORCHIDY_BASE_URL:-https://orchidy.fr}
ENV NEXT_PUBLIC_USE_DEMO=${NEXT_PUBLIC_USE_DEMO:-true}
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
